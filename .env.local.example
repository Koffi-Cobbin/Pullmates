# =============================================================================
# PullMates Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------

# Base URL for the backend API (no trailing slash)
# Used by server-side code and API client to communicate with the backend.
# Example: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------

# The canonical URL of your app (no trailing slash)
# Used by NextAuth for callback URLs, CSRF protection, and session cookies.
# Example: http://localhost:3000
NEXTAUTH_URL=

# A random secret string used to encrypt NextAuth sessions and CSRF tokens.
# Generate one with: openssl rand -base64 32
# MUST be set in production — NextAuth won't work without it.
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# GitHub OAuth
# -----------------------------------------------------------------------------

# Client ID from your GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Used to initiate the GitHub sign-in flow.
GITHUB_CLIENT_ID=

# Client secret from the same GitHub OAuth App
# Keep this secret — never expose it in client-side code or commit history.
GITHUB_CLIENT_SECRET=
