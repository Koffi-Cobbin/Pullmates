# =============================================================================
# PullMates Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (project: Pullmates, ref naujqnbwatuyeiqpsinp)
# -----------------------------------------------------------------------------
# Project Settings > API. The publishable key is safe for client-side use;
# never expose the secret key (sb_secret_...) in frontend code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Canonical origin for metadata, robots.txt and sitemap.xml.
# Production: https://pull-mates.web.app — local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Legacy (only if reviving the old Firebase / API-client code paths)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
